{#- Media stack, kept close to the LinuxServer.io docs. Image tags are pinned
   in roles/media/defaults/main.yml. Secrets come from the rendered .env. -#}
services:
  qbittorrent:
    image: {{ qbittorrent_image }}
    container_name: qbittorrent
    environment:
      - PUID={{ media_uid }}
      - PGID={{ media_gid }}
      - TZ={{ container_timezone }}
      - WEBUI_PORT={{ qbittorrent_webui_port }}
    volumes:
      - {{ appdata_root }}/qbittorrent:/config
      - {{ data_root }}/torrents:/data/torrents
{% if vpn_enabled %}
    # VPN kill switch: qBittorrent shares gluetun's network namespace. If the
    # tunnel is down, qBittorrent has no connectivity at all.
    network_mode: "service:gluetun"
    depends_on: [gluetun]
{% else %}
    # No VPN: ports bound to specific addresses only, never 0.0.0.0. The WebUI
    # listens on localhost (Caddy proxies it); the torrent port on the LAN IP.
    ports:
      - "127.0.0.1:{{ qbittorrent_webui_port }}:{{ qbittorrent_webui_port }}"
      - "{{ lan_ip }}:{{ qbittorrent_torrent_port }}:{{ qbittorrent_torrent_port }}"
      - "{{ lan_ip }}:{{ qbittorrent_torrent_port }}:{{ qbittorrent_torrent_port }}/udp"
{% endif %}
    restart: unless-stopped
    mem_limit: {{ media_mem_limits.qbittorrent }}
    healthcheck:
      test: ["CMD-SHELL", "curl -s -o /dev/null http://localhost:{{ qbittorrent_webui_port }} || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s

{% if vpn_enabled %}
  gluetun:
    image: {{ gluetun_image }}
    container_name: gluetun
    cap_add: [NET_ADMIN]
    devices:
      - /dev/net/tun:/dev/net/tun
    environment:
      - VPN_SERVICE_PROVIDER=${VPN_SERVICE_PROVIDER}
      - VPN_USERNAME=${VPN_USERNAME}
      - VPN_PASSWORD=${VPN_PASSWORD}
      - TZ={{ container_timezone }}
    ports:
      # With the VPN on, qBittorrent's ports are published by gluetun.
      - "127.0.0.1:{{ qbittorrent_webui_port }}:{{ qbittorrent_webui_port }}"
      - "{{ lan_ip }}:{{ qbittorrent_torrent_port }}:{{ qbittorrent_torrent_port }}"
      - "{{ lan_ip }}:{{ qbittorrent_torrent_port }}:{{ qbittorrent_torrent_port }}/udp"
    restart: unless-stopped
    mem_limit: {{ media_mem_limits.gluetun }}
{% endif %}

  prowlarr:
    image: {{ prowlarr_image }}
    container_name: prowlarr
    environment:
      - PUID={{ media_uid }}
      - PGID={{ media_gid }}
      - TZ={{ container_timezone }}
      # LSIO writes its own config files; deny world access (they hold API keys/hashes)
      - UMASK=027
    volumes:
      - {{ appdata_root }}/prowlarr:/config
    ports:
      - "127.0.0.1:{{ prowlarr_port }}:9696"
    restart: unless-stopped
    mem_limit: {{ media_mem_limits.prowlarr }}
    healthcheck:
      test: ["CMD-SHELL", "curl -s -o /dev/null http://localhost:9696 || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s

  sonarr:
    image: {{ sonarr_image }}
    container_name: sonarr
    environment:
      - PUID={{ media_uid }}
      - PGID={{ media_gid }}
      - TZ={{ container_timezone }}
      # LSIO writes its own config files; deny world access (they hold API keys/hashes)
      - UMASK=027
    volumes:
      # Sees both torrents and media: hardlinks + atomic moves need the same
      # filesystem mounted at the same path as qBittorrent uses.
      - {{ appdata_root }}/sonarr:/config
      - {{ data_root }}:/data
    ports:
      - "127.0.0.1:{{ sonarr_port }}:8989"
    restart: unless-stopped
    mem_limit: {{ media_mem_limits.sonarr }}
    healthcheck:
      test: ["CMD-SHELL", "curl -s -o /dev/null http://localhost:8989 || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s

  radarr:
    image: {{ radarr_image }}
    container_name: radarr
    environment:
      - PUID={{ media_uid }}
      - PGID={{ media_gid }}
      - TZ={{ container_timezone }}
      # LSIO writes its own config files; deny world access (they hold API keys/hashes)
      - UMASK=027
    volumes:
      - {{ appdata_root }}/radarr:/config
      - {{ data_root }}:/data
    ports:
      - "127.0.0.1:{{ radarr_port }}:7878"
    restart: unless-stopped
    mem_limit: {{ media_mem_limits.radarr }}
    healthcheck:
      test: ["CMD-SHELL", "curl -s -o /dev/null http://localhost:7878 || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s

  bazarr:
    image: {{ bazarr_image }}
    container_name: bazarr
    environment:
      - PUID={{ media_uid }}
      - PGID={{ media_gid }}
      - TZ={{ container_timezone }}
      # LSIO writes its own config files; deny world access (they hold API keys/hashes)
      - UMASK=027
    volumes:
      - {{ appdata_root }}/bazarr:/config
      - {{ data_root }}:/data
    ports:
      - "127.0.0.1:{{ bazarr_port }}:6767"
    restart: unless-stopped
    mem_limit: {{ media_mem_limits.bazarr }}
    healthcheck:
      test: ["CMD-SHELL", "curl -s -o /dev/null http://localhost:6767 || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s

  jellyseerr:
    image: {{ jellyseerr_image }}
    container_name: jellyseerr
    environment:
      - PUID={{ media_uid }}
      - PGID={{ media_gid }}
      - TZ={{ container_timezone }}
      # LSIO writes its own config files; deny world access (they hold API keys/hashes)
      - UMASK=027
    volumes:
      - {{ appdata_root }}/jellyseerr:/app/config
    ports:
      - "127.0.0.1:{{ jellyseerr_port }}:5055"
    restart: unless-stopped
    mem_limit: {{ media_mem_limits.jellyseerr }}
    # Tested live on 2.7.3 (served 307 with the same flags).
    cap_drop: [ALL]
    security_opt:
      - no-new-privileges:true
    # No curl/wget in this image; Node's fetch works (node >= 18).
    healthcheck:
      test: ["CMD", "node", "-e", "fetch('http://localhost:5055').then(r=>process.exit(r.status<500?0:1)).catch(()=>process.exit(1))"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 60s

  flaresolverr:
    image: {{ flaresolverr_image }}
    container_name: flaresolverr
    environment:
      - TZ={{ container_timezone }}
      - UMASK=027
    ports:
      - "127.0.0.1:{{ flaresolverr_port }}:8191"
    restart: unless-stopped
    mem_limit: {{ media_mem_limits.flaresolverr }}
    # Tested live (docker run with the same flags served 200): the image's
    # own user needs no caps, unlike the root-starting LinuxServer.io images.
    cap_drop: [ALL]
    security_opt:
      - no-new-privileges:true
    healthcheck:
      test: ["CMD-SHELL", "curl -s -o /dev/null http://localhost:8191/ || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 15s

  jellyfin:
    image: {{ jellyfin_image }}
    container_name: jellyfin
    environment:
      - PUID={{ media_uid }}
      - PGID={{ media_gid }}
      - TZ={{ container_timezone }}
      # LSIO writes its own config files; deny world access (they hold API keys/hashes)
      - UMASK=027
    volumes:
      - {{ appdata_root }}/jellyfin:/config
      # Media mounted read-only: Jellyfin never needs to write to the library.
      - {{ data_root }}/media:/data/media:ro
    devices:
      # /dev/dri for Quick Sync (H.264/HEVC/VP9 encode+decode, AV1 decode).
      - /dev/dri:/dev/dri
    group_add:
      # Host render group GID, discovered at apply time (never hardcoded).
      - "{{ render_gid }}"
    ports:
      - "127.0.0.1:{{ jellyfin_port }}:8096"
    restart: unless-stopped
    mem_limit: {{ media_mem_limits.jellyfin }}
    healthcheck:
      test: ["CMD-SHELL", "curl -s -o /dev/null http://localhost:8096/health || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 60s

# One shared network with Caddy and the dashboards (created by the storage
# role); reverse-proxying by container name works across stacks.
networks:
  default:
    name: web
    external: true
