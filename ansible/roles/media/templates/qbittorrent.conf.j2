{#- Pre-seeded before first start so Ansible knows the API key. force=false in
   the copy task means qBittorrent keeps ownership of this file afterwards. -#}
[AutoRun]
enabled=false

[BitTorrent]
Session\DefaultSavePath=/data/torrents
Session\Port={{ qbittorrent_torrent_port }}
Session\TempPath=/data/torrents/.temp

[Core]
AutoDeleteAddedTorrentFile=Never

[LegalNotice]
Confirmed=true

[Meta]
MigrationVersion=8

[Network]
Port={{ qbittorrent_torrent_port }}

[Preferences]
WebUI\Port={{ qbittorrent_webui_port }}
WebUI\HostHeaderValidation=false
WebUI\LocalHostAuth=false
WebUI\Password_PBKDF2="@ByteArray({{ qbittorrent_password_hash }})"
