# Managed by Ansible (roles/nas). Parity drive must be at least as large as
# the biggest data drive. Content files are spread: one per data disk, so a
# single disk failure still leaves the last-known-good layout recoverable.
{% for d in nas_parity_disks %}
parity {{ d.mount }}/snapraid.parity
{% endfor %}
{% for d in nas_data_disks %}
content {{ d.mount }}/snapraid.content
{% endfor %}
{% for d in nas_data_disks %}
data d{{ loop.index }} {{ d.mount }}
{% endfor %}
# Never touch these: Docker runtime, the OS itself, and USB staging.
exclude *.unrecoverable
exclude /tmp/
exclude /lost+found/
exclude /docker/
exclude /var/lib/docker/
exclude /opt/stacks/
smartctl
autosave 0
