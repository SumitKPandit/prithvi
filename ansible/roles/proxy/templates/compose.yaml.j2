{#- The proxy stack. Ports bind ONLY to the LAN and Tailscale addresses. -#}
services:
  caddy:
    build: .
    image: caddy-cloudflare:{{ caddy_version }}
    container_name: caddy
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - {{ appdata_root }}/caddy/data:/data
      - {{ appdata_root }}/caddy/config:/config
    environment:
      - CF_API_TOKEN=${CF_API_TOKEN}
      - TZ={{ container_timezone }}
    ports:
      - "{{ lan_ip }}:443:443"
      - "{{ tailscale_ip }}:443:443"
    restart: unless-stopped
    mem_limit: 256m
    healthcheck:
      test: ["CMD-SHELL", "wget -q -O /dev/null http://localhost:2015/ || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s

networks:
  default:
    name: web
    external: true
