{#- One wildcard cert covers every private service; named matchers route.
    Without a Cloudflare token the proxy falls back to Caddy's internal CA
    (self-signed, browser warnings) so everything stays reachable. -#}
{% if acme_email | length > 0 %}
{
  # Certificate expiry/problem notices from Let's Encrypt.
  email {{ acme_email }}
}
{% endif %}
*.{{ private_host_suffix }} {
{% if cf_dns01 %}
  # Real Let's Encrypt certs via Cloudflare DNS-01: no open ports needed.
  tls {
    dns cloudflare {$CF_API_TOKEN}
  }
{% else %}
  # No Cloudflare token yet: self-signed internal certificates.
  tls internal
{% endif %}

{% for item in private_services %}
  @{{ item.name }} host {{ item.name }}.{{ private_host_suffix }}
  handle @{{ item.name }} {
{% if item.name == 'qbittorrent' and vpn_enabled %}
    # VPN on: qBittorrent shares gluetun's net namespace.
    reverse_proxy gluetun:{{ item.port }}
{% else %}
    reverse_proxy {{ item.host }}:{{ item.port }}
{% endif %}
  }
{% endfor %}

  # Anything else on the wildcard: explicit 404.
  handle {
    respond "not found" 404
  }
}

# Container-local plain HTTP listener, only for the Docker healthcheck (never
# published; the wildcard cert cannot answer SNI "localhost", so no TLS here).
http://127.0.0.1:2015 {
  respond "ok" 200
}
