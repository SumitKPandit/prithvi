{#- Joins dokploy-network (attachable overlay) so the tunnel can reach
    dokploy-traefik by container name, per Dokploy's Cloudflare guide. -#}
services:
  cloudflared:
    image: {{ cloudflared_image }}
    container_name: cloudflared
    command: tunnel --no-autoupdate run --token ${TUNNEL_TOKEN}
    restart: unless-stopped
    mem_limit: 128m

networks:
  default:
    name: dokploy-network
    external: true
