#!/bin/sh
# Pre-backup dumps for state that cannot be file-copied coherently while the
# app is running. Output goes to {{ backup_root }}/dumps, which backup-run.sh
# feeds to restic.
set -eu

{% if dokploy_enabled | bool %}
# Dokploy's Postgres. Its PGDATA volume is deliberately excluded from the
# restic backup (a live file copy of Postgres is worthless); this dump is
# the authoritative database backup.
# Redirection first, gzip separately: POSIX sh has no pipefail, a pipeline
# would hide a failed pg_dump behind a successful gzip.
docker exec "$(docker ps -q -f name=dokploy-postgres)" \
  pg_dump -U dokploy -d dokploy \
  > {{ backup_root }}/dumps/dokploy-postgres.sql
gzip -f {{ backup_root }}/dumps/dokploy-postgres.sql
{% else %}
echo "dokploy disabled: skipping the postgres dump"
{% endif %}

# Uptime Kuma 2.x keeps its data in an embedded MariaDB whose datadir is
# {{ appdata_root }}/uptime-kuma/mariadb. Dump the `kuma` database through
# the container's unix socket. The only unix-socket identity the embedded
# MariaDB accepts is the OS user `node` (mariadbd runs as --user=node); no
# password is stored anywhere.
if docker ps --format '{{ '{{.Names}}' }}' | grep -qx uptime-kuma; then
  docker exec -u node uptime-kuma \
    mariadb-dump -u node -S /app/data/run/mariadb.sock \
    kuma > {{ backup_root }}/dumps/kuma.sql
  gzip -f {{ backup_root }}/dumps/kuma.sql
else
  echo "uptime-kuma: container not running, skipping the dump"
fi
