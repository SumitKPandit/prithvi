#!/bin/sh
# Daily backup: dumps -> restic snapshot -> retention -> rclone to Drive.
# Any failed step pushes status=down to the Uptime Kuma push monitor (when
# its token exists); a backup that never runs shows up there as silence.
set -eu

export RESTIC_REPOSITORY={{ backup_root }}/restic
export RESTIC_PASSWORD_FILE=/etc/restic.pass

STEP=start
KUMA_BACKUP_PUSH_TOKEN=
if [ -f /etc/kuma-push.env ]; then . /etc/kuma-push.env; fi

push() {
  [ -n "${KUMA_BACKUP_PUSH_TOKEN:-}" ] || return 0
  # Alerting must never fail the backup itself.
  curl -fsS --max-time 15 \
    "https://uptime.{{ private_host_suffix }}/api/push/${KUMA_BACKUP_PUSH_TOKEN}?status=$1&msg=$2" \
    >/dev/null || echo "WARN: Uptime Kuma push failed"
}

trap 'push down "backup-failed-$STEP"' EXIT

STEP=dump
/usr/local/bin/backup-dump.sh

STEP=init
restic snapshots >/dev/null 2>&1 || restic init

STEP=backup
# dokploy-postgres is excluded on purpose: its live PGDATA copy is worthless,
# the dump from backup-dump.sh is the authority.
restic backup \
  --exclude /var/lib/docker/volumes/dokploy-postgres \
  --exclude {{ appdata_root }}/uptime-kuma/mariadb \
  {{ appdata_root }} \
  {{ stacks_root }} \
  /etc/dokploy \
  /var/lib/docker/volumes \
  {{ backup_root }}/dumps

STEP=forget
restic forget \
  --keep-daily {{ backup_keep_daily }} \
  --keep-weekly {{ backup_keep_weekly }} \
  --keep-monthly {{ backup_keep_monthly }}

STEP=sync
if [ -f /etc/rclone/rclone.conf ]; then
  rclone --config /etc/rclone/rclone.conf sync \
    {{ backup_root }}/restic \
    {{ backup_rclone_remote }}:{{ backup_drive_path }} \
    --transfers 4 --checkers 8
else
  echo "rclone: no Drive token yet, keeping the backup local only"
fi

trap - EXIT
push up backup-ok
