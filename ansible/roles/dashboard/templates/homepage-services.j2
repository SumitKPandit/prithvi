{#- Links only (no API widgets) to keep the dashboard maintenance-free. -#}
---
- name: Media
{% for item in private_services if item.name in media_services %}
  - name: {{ item.name | capitalize }}
    description: {{ item.desc }}
    href: https://{{ item.name }}.{{ private_host_suffix }}
    target: _blank
{% endfor %}
- name: Infra
{% for item in private_services if item.name not in media_services %}
  - name: {{ item.name | capitalize }}
    description: {{ item.desc }}
    href: https://{{ item.name }}.{{ private_host_suffix }}
    target: _blank
{% endfor %}
