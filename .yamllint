---
# Matches the relaxed style already used in this repo (quoted modes, 8-space
# indent for lists is fine). Line length generous because Jinja lines get long.
extends: default
rules:
  line-length:
    max: 120
  truthy:
    allowed-values: ["true", "false", "yes", "no"]
  comments-indentation: false
  comments:
    min-spaces-from-content: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  braces:
    max-spaces-inside: 1
